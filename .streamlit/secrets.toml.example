# Copy these entries into the app's Secrets box on Streamlit Community Cloud
# (App settings > Secrets). Never commit real values.

# AI assistant (Gemini). Rotate the key that was exposed earlier before use.
GEMINI_API_KEY = "paste-your-new-key"

# Editor password: viewers can read everything; only the editor changes inputs.
EDITOR_PASSWORD = "choose-a-strong-password"

# Weekly data: the repository whose `data` branch the weekly workflow writes.
SSDM_DATA_REPO = "Shayan9574/ssdm-dashboard"
SSDM_DATA_BRANCH = "data"
# Only when the repository is private: a fine grained token with read access
# to its contents.
# GITHUB_TOKEN = "github_pat_..."

# Expert inputs storage (Google Sheet). Create a sheet, share it with the
# service account's email as Editor, and paste its ID (the long string in
# the sheet's URL) and the service account key below.
SSDM_SHEET_ID = "the-sheet-id"

[gcp_service_account]
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "...@....iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"
